 def make_envs(config):
     suite = config.task.split("_", 1)[0]
 
+    if suite == "wow":
+        # mod-neuralbot batched shared-memory env: one env object IS the 400-bot batch,
+        # so skip ParallelEnv (subprocess-per-env) entirely.
+        import os
+        import sys
+        sys.path.insert(
+            0, os.path.abspath(os.path.join(os.path.dirname(__file__), "..", "..", "..", "python"))
+        )
+        from wow_world_model_env import WoWWorldModelEnv
+        train_envs = WoWWorldModelEnv(num_bots=config.env_num)
+        eval_envs = None
+        return train_envs, eval_envs, train_envs.observation_space, train_envs.action_space
+
     if suite == "isaaclab":
         return _make_isaaclab_envs(config)
 
