NeuralBot.Enable = 1
# Legacy TCP debug handler (superseded by the shm protocol). 0 = disabled.
# Keep disabled — the accept thread has caused shutdown crashes. Enable only for debugging.
NeuralBot.WebSocketPort = 0
NeuralBot.TickRateMs = 50
NeuralBot.BotCharacterName = "Neuralbot"
NeuralBot.BotAccountId = 0
NeuralBot.MaxEpisodeSteps = 1000
NeuralBot.LogPackets = 0
NeuralBot.CleanupOnStartup = 0
# Auto-accept + auto-complete quests. DISABLED (0) — the bots should LEARN to
# pick up quests (INTERACT_TARGET at a quest giver) and turn them in
# (COMPLETE_QUEST), not have them scaffolded. Reward selection at turn-in is
# class/spec-aware (see NeuralBotInstance::ChooseQuestReward).
NeuralBot.AutoQuest = 0
NeuralBot.BotCount = 1600

# Level-band respawn (DISABLED-by-default? no — ENABLED). When a bot dies or its episode
# resets and it has out-leveled the starting subzone (level >= 5), respawn it at a
# faction-appropriate quest hub matching its level band (1-4 subzone, 5-9 main hub,
# 10-19 next-zone hub). Graveyard coordinates from game_graveyard. This is the "player
# progresses naturally to the next hub" mechanism — quests still drive progression, but
# the bot is placed in level-appropriate content so gray-mob XP collapse can't happen.
NeuralBot.LevelBandRespawn = 1

# Perf instrumentation: log batch cycle/step/wait timings (module.neuralbot.perf)
# every N shared-memory batches. 0 disables. Covers cycle=step+wait where wait is the
# Python reader + policy + handshake latency between batches.
NeuralBot.PerfLogInterval = 250

# Behavior-cloning demonstration recorder: when non-empty, appends fixed-size
# NeuralBotBcRecord entries (header + full frame) for every playerbot action executed.
# Used to record expert demonstrations from mod-playerbots for BC warm-start.
NeuralBot.BcRecordPath = ""
# Downsample factor: 1 = record every action, N = every Nth action.
NeuralBot.BcRecordEvery = 1

# Curriculum teleport: stage bots next to the nearest HOSTILE within 120 yd at episode
# start. DISABLED (0) — starting-zone mobs are mostly neutral, so the nearest hostile is
# usually a level-5+ mob outside the enclave that kills the level-1 bot in ~10 steps
# (no "deal damage -> kill" data ever enters the buffer). Bots now spawn like a real
# player and fight level-appropriate mobs naturally.
NeuralBot.Curriculum = 0
