NeuralBot.Enable = 1
# Legacy TCP debug handler (superseded by the shm protocol). 0 = disabled.
# Keep disabled — the accept thread has caused shutdown crashes. Enable only for debugging.
NeuralBot.WebSocketPort = 0
NeuralBot.TickRateMs = 50
NeuralBot.BotCharacterName = "Neuralbot"
NeuralBot.BotAccountId = 0
NeuralBot.MaxEpisodeSteps = 1000
NeuralBot.LogPackets = 0
NeuralBot.CleanupOnStartup = 0
NeuralBot.AutoQuest = 1
NeuralBot.BotCount = 400

# Perf instrumentation: log batch cycle/step/wait timings (module.neuralbot.perf)
# every N shared-memory batches. 0 disables. Covers cycle=step+wait where wait is the
# Python reader + policy + handshake latency between batches.
NeuralBot.PerfLogInterval = 250

# Behavior-cloning demonstration recorder: when non-empty, appends fixed-size
# NeuralBotBcRecord entries (header + full frame) for every playerbot action executed.
# Used to record expert demonstrations from mod-playerbots for BC warm-start.
NeuralBot.BcRecordPath = ""
# Downsample factor: 1 = record every action, N = every Nth action.
NeuralBot.BcRecordEvery = 1
